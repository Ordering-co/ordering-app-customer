{
  // React Native's own base (RN 0.88): Hermes's lib, bundler resolution with the
  // "react-native" condition, skipLibCheck (libraries' own .d.ts are not this
  // app's to check: they conflict among themselves, e.g. RN's globals and @types/node).
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "@/*": ["src/*"],
      "@": ["src/*"],
      "@components": ["src/@/components/native/index.js"],
      "@ui": ["src/ui/index.tsx"],
      "@orderingco/ordering-theme-engine/runtime": ["node_modules/@orderingco/ordering-theme-engine/dist/runtime.d.ts"],
      "@orderingco/ordering-theme-engine/native": ["node_modules/@orderingco/ordering-theme-engine/dist/native.d.ts"],
      "@orderingco/ordering-theme-engine/colors": ["node_modules/@orderingco/ordering-theme-engine/dist/palette.d.ts"]
    },
    "plugins": [
      {
        "name": "typescript-styled-plugin",
        "lint": {
          "unknownProperties": "ignore"
        }
      }
    ]
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "jest",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/@/components"
  ]
}
