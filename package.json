{
  "name": "app-marketplace-2",
  "version": "0.0.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ordering-co/ordering-app-customer.git"
  },
  "bugs": {
    "url": "https://github.com/Ordering-co/ordering-app-customer/issues"
  },
  "homepage": "https://github.com/Ordering-co/ordering-app-customer",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage:summary": "node scripts/coverage-summary.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "i18n:generate": "node i18n/generate.cjs",
    "i18n:verify": "node i18n/verify.cjs",
    "i18n:missing": "node i18n/missing.cjs",
    "i18n:apply-batch": "node i18n/applyBatch.cjs",
    "i18n:sync": "node i18n/sync.cjs --dry-run",
    "i18n:check-generated": "node i18n/check-generated.cjs",
    "theme:validate": "ordering-theme validate product.schema.json",
    "theme:compile": "ordering-theme compile product.schema.json --out src/theme.compiled.json",
    "theme:verify": "ordering-theme compile product.schema.json --out src/theme.compiled.json --check",
    "theme:guard": "node scripts/theme/guard.mjs . --src src --exclude 'src/@/' --allow theme-exceptions.json --categories color,space,radius,border,shadow,shadow_part,font_size,font_weight,font_family,line_height,letter_spacing,motion,opacity,size",
    "theme:extremes": "node scripts/theme/extremes.mjs",
    "theme:publish": "ordering-theme publish product.schema.json",
    "theme:publish:dry": "ordering-theme publish product.schema.json --dry-run",
    "onboarding": "node scripts/onboarding/cli.mjs",
    "test:onboarding": "jest src/onboarding --runInBand --watchman=false",
    "test:onboarding:helpers": "node --test scripts/onboarding/*.test.mjs",
    "ordering:ios-local": "node scripts/onboarding/ios-local.mjs"
  },
  "dependencies": {
    "@intercom/intercom-react-native": "^10.9.0",
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.0",
    "@react-native-community/datetimepicker": "9.2.2",
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-community/netinfo": "^11.3.3",
    "@react-native-firebase/analytics": "^26.4.1",
    "@react-native-firebase/app": "^26.4.1",
    "@react-native-firebase/crashlytics": "^26.4.1",
    "@react-native-firebase/messaging": "^26.4.1",
    "@react-native-google-signin/google-signin": "17.0.0",
    "@react-native-vector-icons/fontawesome": "14.0.0",
    "@react-native-vector-icons/fontawesome5": "14.0.0",
    "@react-native-vector-icons/ionicons": "14.0.0",
    "@react-native-vector-icons/material-design-icons": "14.0.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/stack": "^7.12.1",
    "@segment/analytics-react-native": "^2.21.3",
    "@segment/sovran-react-native": "^1.1.3",
    "@sentry/react-native": "8.33.0",
    "@stripe/stripe-react-native": "0.83.0",
    "dayjs": "^1.11.10",
    "decimal.js": "^10.4.3",
    "libphonenumber-js": "1.13.15",
    "lottie-react-native": "^7.3.4",
    "moment": "^2.29.1",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-bootsplash": "^7.3.5",
    "react-native-country-picker-modal": "3.0.0",
    "react-native-credit-card-input": "1.0.0",
    "react-native-device-info": "^15.0.2",
    "react-native-fast-image": "^10.11.0",
    "react-native-fbsdk-next": "^13.4.1",
    "react-native-gesture-handler": "2.33.1",
    "react-native-get-random-values": "^2.1.0",
    "react-native-google-places-textinput": "^0.8.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-map-link": "^3.15.0",
    "react-native-maps": "1.29.11",
    "react-native-notify-kit": "^9.7.0",
    "react-native-onesignal": "5.5.17",
    "react-native-otp-entry": "^1.8.6",
    "react-native-permissions": "5.6.3",
    "react-native-recaptcha-that-works": "^1.2.0",
    "react-native-restart": "^0.0.29",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-uuid": "^2.0.1",
    "react-native-webview": "^14.0.1",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.0"
